# Edge Function secrets (Feature 17). Set the real values in the Supabase dashboard:
# Project → Edge Functions → Secrets. Never commit real values.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are provided by the platform.

# Anthropic (platform.claude.com → API keys). Leave the placeholder until you add credits:
# the AI features then show "AI isn't set up yet" instead of failing.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Your auth user id. Every function refuses other accounts (signup is open).
AXON_OWNER_ID=00000000-0000-0000-0000-000000000000

# Optional: comma-separated browser origins allowed to call the functions.
ALLOWED_ORIGINS=http://localhost:6420

# Jira (Phase 2): the Atlassian account email and API token.
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=REPLACE_ME
