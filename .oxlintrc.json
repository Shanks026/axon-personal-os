{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "node_modules", ".claude"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@supabase/supabase-js",
            "message": "Only src/lib/supabase.js may import the Supabase SDK. Use feature api.js files."
          }
        ],
        "patterns": [
          {
            "group": ["../**"],
            "message": "Use the @/ alias instead of climbing with ../ (see .claude/rules/project-structure.md)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/supabase.js"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/components/ui/**", "src/hooks/use-mobile.js"],
      "rules": {
        "react/only-export-components": "off",
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": ["src/context/**", "src/**/*Context.jsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
